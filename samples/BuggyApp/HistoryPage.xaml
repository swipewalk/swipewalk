<?xml version="1.0" encoding="utf-8" ?>
<!-- Second ground-truth screen, reached from "View payment history". Used to test record mode.
     With the default MAUI template, changing the Android text size restarts the app and returns to
     MainPage, so record mode cannot run the large-text check here (framework note).
     Also carries a planted bug for the auto-update-content scan option (WCAG 2.2.2 Pause, Stop,
     Hide): the banner below cycles its text every 2 seconds, starting automatically, with no way to
     pause, stop or hide it. Not part of ground-truth.json's exact-match assertions (scoped to
     MainPage; see GroundTruthTests) -- see ground-truth.json's own description for the live-scan
     verification of this bug, and AutoUpdatingContentRuleTests for the rule/detector unit tests. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BuggyApp.HistoryPage"
             Title="Payment history"
             BackgroundColor="White">

    <VerticalStackLayout Padding="20,12" Spacing="12">
        <!-- OK: heading. -->
        <Label Text="Your payments" FontSize="20" TextColor="#1F1F1F" SemanticProperties.HeadingLevel="Level1" />

        <!-- OK: rows of plain text. -->
        <Label Text="Ticket A1234 · $45.00 · Paid on Sep 2" FontSize="16" TextColor="#1F1F1F" />
        <Label Text="Ticket B5678 · $30.00 · Paid on Aug 14" FontSize="16" TextColor="#1F1F1F" />

        <!-- Planted bug (auto-update-1): a promotional banner that cycles its text automatically,
             every 2 seconds, forever, with no button or gesture to pause, stop or hide it: a WCAG
             2.2.2 Pause, Stop, Hide concern. -->
        <Label x:Name="PromoBanner" Text="New: Autopay available -- never miss a due date" FontSize="14"
               TextColor="#1F1F1F" BackgroundColor="#FFF4CE" Padding="10" />
    </VerticalStackLayout>
</ContentPage>
